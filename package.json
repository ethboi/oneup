{
  "name": "oneup",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build:contracts": "cd contracts && ./build.sh",
    "localnet": "tsx scripts/localnet.ts",
    "localnet:reset": "rm -rf .localnet localnet.json",
    "deploy:local": "tsx scripts/deploy.ts",
    "test": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --manifest-path contracts/Cargo.toml --workspace --exclude oneup-integration && pnpm -r --filter=!@oneup/app test",
    "typecheck": "tsc -b",
    "test:ts": "node --import tsx --test app/test/*.ts keeper/test/*.ts",
    "smoke": "tsx scripts/smoke.ts",
    "keeper": "pnpm --filter @oneup/keeper start",
    "bots": "pnpm --filter @oneup/bots start",
    "bots:add": "tsx scripts/add-bots.ts",
    "mcp": "pnpm --silent --filter @oneup/mcp start",
    "agent": "pnpm --silent --filter @oneup/mcp agent",
    "sim": "pnpm --filter @oneup/sim start",
    "demo": "tsx scripts/demo.ts",
    "test:sandbox": "contracts/build.sh && PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --manifest-path contracts/Cargo.toml -p oneup-integration",
    "stop": "tsx scripts/stop.ts",
    "farm": "pnpm --filter @oneup/sim exec tsx src/farm.ts",
    "sim:sensitivity": "pnpm --filter @oneup/sim exec tsx src/sensitivity.ts",
    "demo:judge": "tsx scripts/judge-demo.ts",
    "test:judge": "tsx scripts/judge-e2e.ts",
    "verify:deployment": "tsx scripts/deployment-check.ts",
    "verify": "tsx scripts/verify.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "preflight": "tsx scripts/preflight.ts",
    "test:judge:ci": "tsx scripts/judge-ci.ts",
    "test:economics": "tsx scripts/economic-report.ts",
    "deploy:testnet": "tsx scripts/deploy-testnet.ts",
    "testnet:bots": "tsx scripts/testnet-bots.ts",
    "testnet:finish": "tsx scripts/testnet-finish.ts",
    "testnet:indexer": "tsx scripts/testnet-indexer.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.1",
    "near-sandbox": "0.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@oneup/sdk": "workspace:*",
    "near-api-js": "7.3.1"
  },
  "license": "AGPL-3.0-only"
}
